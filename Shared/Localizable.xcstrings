        }
      }
    },
    "Živé aktivity se nepodařilo spustit. Zkontroluj, že je máš povolené v Nastavení iOS → Termínovník." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t start Live Activities. Make sure they’re enabled in iOS Settings → Termínovník."
