    "Údaje o předmětu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subject details"
          }
        }
      }
    },
    "Údaje o účtu, předměty, deadliny, rozvrh a termíny." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account details, subjects, deadlines, timetable and exam dates."
          }
        }
      }
    },
    "Údaje přímo v IS/STAG spravuje tvoje škola. Žádosti o jejich opravu, výmaz nebo odvolání souhlasu směřuj na ni." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data held directly in IS/STAG is managed by your school. Please direct any requests for its rectification or erasure, or for withdrawal of consent, to your school."
          }
        }
      }
    },
    "Údaje, které zadáš sám" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data you enter yourself"
          }
        }
      }
    },
